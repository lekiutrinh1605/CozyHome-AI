# Environment & Secrets (TUYỆT ĐỐI KHÔNG PUSH LÊN GITHUB)
.env
*.env.local

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Operating System & IDE
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Temporary, Scratch & Backup Files
*.bak
*.orig
*.orig.*
scratch/
scratch_*.txt
*.log

# User Uploads (Giữ thư mục qua .gitkeep)
static/uploads/*
!static/uploads/.gitkeep
